---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import TutorialSteps from '../../components/TutorialSteps.astro';
import ToolCard from '../../components/ToolCard.astro';
import ChineseSupportBadge from '../../components/ChineseSupportBadge.astro';
import FreeAlternativeItem from '../../components/FreeAlternativeItem.astro';
import { getAllTools, getSimilarTools, getToolScenarios, getFreeAlternatives, getToolFavicon, getToolIcon } from '../../utils/data';
import { generateToolJsonLd } from '../../utils/seo';
import { formatPricing, formatDate } from '../../utils/formatters';
import type { Tool } from '../../types/index';

export function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props as { tool: Tool };
const BASE = import.meta.env.BASE_URL || '/';
const similarTools = getSimilarTools(tool.id);
const applicableScenarios = getToolScenarios(tool.id);
const freeAlts = getFreeAlternatives().filter((a) => a.freeTool.id === tool.id);
const pricingInfo = formatPricing(tool.pricing);
const toolJsonLd = generateToolJsonLd(tool);

// Breadcrumb JSON-LD
const breadcrumbLd = [
  { name: '首页', url: 'https://allencxw0812.github.io/autocontentflow/' },
  { name: 'AI工具评测', url: 'https://allencxw0812.github.io/autocontentflow/tools' },
  ...(tool.category.length > 0
    ? [{ name: tool.category[0] === 'ai-chat' ? 'AI对话' : tool.category[0], url: `https://allencxw0812.github.io/autocontentflow/tools#${tool.category[0]}` }]
    : []),
  { name: tool.name },
];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org' as const,
  '@type': 'BreadcrumbList' as const,
  itemListElement: breadcrumbLd.map((item, index) => ({
    '@type': 'ListItem' as const,
    position: index + 1,
    name: item.name,
    ...(item.url ? { item: item.url } : {}),
  })),
};

// FAQ JSON-LD
const faqJsonLd = {
  '@context': 'https://schema.org' as const,
  '@type': 'FAQPage' as const,
  mainEntity: [
    {
      '@type': 'Question' as const,
      name: `${tool.name}是免费的吗？`,
      acceptedAnswer: {
        '@type': 'Answer' as const,
        text: tool.freeQuota
          ? `${tool.name}提供免费额度，${tool.pricingDetail || '可以免费使用基础功能。'}`
          : `${tool.name}需要付费使用，${tool.pricingDetail || '暂不提供免费版本。'}`,
      },
    },
    {
      '@type': 'Question' as const,
      name: `${tool.name}需要翻墙吗？`,
      acceptedAnswer: {
        '@type': 'Answer' as const,
        text: tool.needsVPN
          ? `${tool.name}需要翻墙才能访问，建议使用稳定的网络工具。`
          : `${tool.name}可以直接访问，无需翻墙。`,
      },
    },
    {
      '@type': 'Question' as const,
      name: `${tool.name}适合什么人使用？`,
      acceptedAnswer: {
        '@type': 'Answer' as const,
        text: tool.review.targetUsers,
      },
    },
    {
      '@type': 'Question' as const,
      name: `${tool.name}有什么缺点？`,
      acceptedAnswer: {
        '@type': 'Answer' as const,
        text: tool.review.painPoints,
      },
    },
  ],
};

const jsonLd = [toolJsonLd, breadcrumbJsonLd, faqJsonLd];
---

<BaseLayout
  meta={{
    title: `${tool.name}评测`,
    description: tool.description,
  }}
  jsonLd={jsonLd}
>
  <Breadcrumb items={[
    { label: 'AI工具评测', href: `${BASE}tools` },
    { label: tool.name },
  ]} />

  <!-- Tool Header -->
  <div class="mb-8">
    <div class="flex items-start gap-5">
      <div class="w-16 h-16 rounded-xl bg-white border border-border flex items-center justify-center shrink-0 overflow-hidden">
        <img
          src={getToolIcon(tool.id)}
          alt={tool.name}
          class="w-10 h-10 object-contain"
          onerror={`this.onerror=null;this.src='${getToolFavicon(tool.url, 64)}'`}
          loading="lazy"
        />
      </div>
      <div class="flex-1">
        <h1 class="text-2xl md:text-3xl font-bold">{tool.name}</h1>
        <p class="text-text-secondary mt-1">{tool.tagline}</p>

        <!-- Tags -->
        <div class="flex items-center gap-2 mt-3 flex-wrap">
          <span class={`text-xs px-2.5 py-1 rounded-full font-medium border ${pricingInfo.color}`}>
            {pricingInfo.label}
          </span>
          <ChineseSupportBadge level={tool.chineseSupport} />
          {tool.needsVPN ? (
            <span class="text-xs px-2.5 py-1 rounded-full bg-red-50 text-red-600 border border-red-200 font-medium">需翻墙</span>
          ) : (
            <span class="text-xs px-2.5 py-1 rounded-full bg-green-50 text-green-600 border border-green-200 font-medium">无需翻墙</span>
          )}
          {tool.freeQuota && (
            <span class="text-xs px-2.5 py-1 rounded-full bg-blue-50 text-blue-600 border border-blue-200 font-medium">有免费额度</span>
          )}
        </div>

        {tool.pricingDetail && (
          <p class="text-text-secondary text-sm mt-2">{tool.pricingDetail}</p>
        )}

        <!-- Platforms -->
        <div class="flex items-center gap-3 mt-3 text-xs text-text-secondary">
          <span>支持平台：{tool.platforms.join(' / ')}</span>
          <span class="text-border">|</span>
          <span>更新于 {formatDate(tool.updatedAt)}</span>
        </div>

        <!-- Visit -->
        <a
          href={tool.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-3 px-5 py-2 bg-primary bg-gradient-to-r from-primary to-primary-light text-white text-sm font-medium rounded-lg hover:opacity-90 transition-opacity"
        >
          访问官网 →
        </a>
      </div>
    </div>
  </div>

  <!-- Description -->
  <section class="mb-8">
    <p class="text-text-primary leading-relaxed">{tool.description}</p>
  </section>

  <!-- Review Section -->
  <section class="mb-8">
    <ReviewSection tool={tool} />
  </section>

  <!-- Tutorial -->
  {tool.tutorial && tool.tutorial.length > 0 && (
    <section class="mb-8">
      <TutorialSteps steps={tool.tutorial} />
    </section>
  )}

  <!-- Related Articles -->
  {tool.articles && tool.articles.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-bold mb-4">📰 系列文章</h2>
      <div class="space-y-3">
        {tool.articles.map((article) => (
          <a
            href={article.url}
            class="flex items-center gap-3 p-4 bg-white rounded-lg border border-border hover:border-primary/40 hover:shadow-sm transition-all group"
          >
            <span class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary text-sm shrink-0 group-hover:bg-primary/20 transition-colors">📄</span>
            <span class="text-sm font-medium text-text-primary group-hover:text-primary transition-colors">{article.title}</span>
            <span class="ml-auto text-xs text-text-secondary shrink-0">公众号</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Similar Tools -->
  {similarTools.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-bold mb-4">🔄 同类对比</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {similarTools.map((st) => (
          <ToolCard tool={st} />
        ))}
      </div>
    </section>
  )}

  <!-- Free Alternatives (this tool is free alt to...) -->
  {freeAlts.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-bold mb-4">🆓 免费替代</h2>
      <div class="space-y-3">
        {freeAlts.map((alt) => (
          <FreeAlternativeItem alternative={{ paidToolId: alt.paidTool.id, freeToolId: alt.freeTool.id, note: alt.note }} />
        ))}
      </div>
    </section>
  )}

  <!-- Applicable Scenarios -->
  {applicableScenarios.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-bold mb-4">🎯 适用场景</h2>
      <div class="flex flex-wrap gap-3">
        {applicableScenarios.map((sc) => (
          <a
            href={`${BASE}scenarios/${sc.slug}`}
            class="px-4 py-2 bg-white rounded-full border border-primary/20 text-sm text-primary hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm"
          >
            {sc.icon} {sc.name}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- CTA: 知识星球 + 公众号 -->
  <section class="mb-8">
    <div class="bg-gradient-to-br from-primary/5 via-primary/10 to-primary-light/5 rounded-xl border border-primary/20 p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center gap-5">
        <div class="flex-1">
          <h3 class="text-lg font-bold text-text-primary">
            📚 获取{tool.name}完整实战提示词
          </h3>
          <p class="text-sm text-text-secondary mt-2 leading-relaxed">
            加入「AI实战圈」知识星球，获取 <strong class="text-text-primary">20+工具完整提示词库</strong> + 一对一答疑 + 每周AI工具测评更新
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="https://t.zsxq.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-2.5 bg-primary bg-gradient-to-r from-primary to-primary-light text-white text-sm font-medium rounded-lg hover:opacity-90 transition-opacity"
          >
            ✨ 加入知识星球
          </a>
          <a
            href="https://mp.weixin.qq.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-2.5 bg-white text-primary text-sm font-medium rounded-lg border border-primary/30 hover:bg-primary/5 transition-colors"
          >
            📱 关注公众号
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
