---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getAllTools, categoryNames } from '../../utils/data';
import type { CategoryId } from '../../types/index';

const tools = getAllTools();

// Group by category
const grouped: Record<string, typeof tools> = {};
for (const tool of tools) {
  for (const cat of tool.category) {
    if (!grouped[cat]) grouped[cat] = [];
    grouped[cat].push(tool);
  }
}

const categories = Object.keys(grouped) as CategoryId[];
---

<BaseLayout
  meta={{
    title: 'AI工具评测',
    description: '真实评测各类AI工具，包含三维评分、中文友好度、免费额度等信息，帮你做出最好的选择。',
  }}
>
  <Breadcrumb items={[{ label: 'AI工具评测' }]} />

  <div class="mb-8">
    <h1 class="text-3xl font-bold">AI工具评测</h1>
    <p class="text-text-secondary mt-2">真实评测，帮你做出最好的选择</p>
  </div>

  <!-- Search & Filter hint -->
  <div class="mb-8">
    <form action="/search" method="get" class="relative max-w-md">
      <input
        type="text"
        name="q"
        placeholder="搜索工具名称、分类..."
        class="w-full h-11 pl-10 pr-4 text-sm bg-bg-white border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all"
      />
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </form>
  </div>

  <!-- Category Sections -->
  {categories.map((cat) => {
    const catTools = grouped[cat];
    const catName = categoryNames[cat] || cat;
    return (
      <section class="mb-10">
        <h2 class="text-xl font-bold mb-4">{catName}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {catTools.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
      </section>
    );
  })}
</BaseLayout>
