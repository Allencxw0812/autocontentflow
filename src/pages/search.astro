---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const BASE = import.meta.env.BASE_URL || '/';
---

<BaseLayout
  meta={{
    title: '搜索',
    description: '搜索AI工具和场景，快速找到你需要的内容。',
  }}
>
  <Breadcrumb items={[{ label: '搜索' }]} />

  <div class="mb-8">
    <h1 class="text-3xl font-bold">搜索</h1>
    <p class="text-text-secondary mt-2">搜索AI工具和场景，快速找到你需要的内容</p>
  </div>

  <div id="search-input-wrapper" class="mb-4">
    <input
      id="pagefind-query"
      type="text"
      placeholder="搜索AI工具、场景..."
      class="w-full h-12 px-4 text-sm bg-bg-white border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all"
    />
  </div>

  <!-- Hot Search Tags -->
  <div class="mb-8 flex flex-wrap gap-2 items-center">
    <span class="text-xs text-text-secondary shrink-0">🔥 热搜：</span>
    <a href={`${BASE}search?q=AI写周报`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">AI写周报</a>
    <a href={`${BASE}search?q=免费AI工具`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">免费AI工具</a>
    <a href={`${BASE}search?q=AI绘画`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">AI绘画</a>
    <a href={`${BASE}search?q=AI做PPT`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">AI做PPT</a>
    <a href={`${BASE}search?q=小红书文案`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">小红书文案</a>
    <a href={`${BASE}search?q=AI翻译`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">AI翻译</a>
    <a href={`${BASE}search?q=论文写作`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">论文写作</a>
    <a href={`${BASE}search?q=短视频`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-primary/15 text-primary hover:bg-primary/5 hover:border-primary/30 transition-colors">短视频</a>
  </div>

  <div id="search-results" class="space-y-3"></div>

  <noscript>
    <p class="text-text-secondary text-center py-8">请启用JavaScript以使用搜索功能</p>
  </noscript>
</BaseLayout>

<script>
  window.__BASE__ = '{`${BASE}`}';
</script>
<script is:inline>
  (async function() {
    const BASE = window.__BASE__ || '/';
    const input = document.getElementById('pagefind-query');
    const resultsContainer = document.getElementById('search-results');
    if (!input || !resultsContainer) return;

    // Get initial query from URL
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    input.value = initialQuery;

    let pagefind = null;

    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import(`${BASE}pagefind/pagefind.js`);
        return pagefind;
      } catch {
        return null;
      }
    }

    async function performSearch(query) {
      if (!query.trim()) {
        resultsContainer.innerHTML = '';
        return;
      }

      resultsContainer.innerHTML = '<p class="text-text-secondary text-center py-8 text-sm">正在搜索...</p>';

      const pf = await loadPagefind();
      if (!pf) {
        resultsContainer.innerHTML = '<p class="text-text-secondary text-center py-8 text-sm">搜索功能将在构建部署后可用</p>';
        return;
      }

      try {
        const search = await pf.search(query);
        const results = await Promise.all(
          search.results.slice(0, 10).map(function(result) { return result.data(); })
        );

        if (results.length === 0) {
          resultsContainer.innerHTML = '<p class="text-text-secondary text-center py-8 text-sm">没有找到相关结果</p>';
          return;
        }

        resultsContainer.innerHTML = results.map(function(r) {
          return '<a href="' + r.url + '" class="block bg-bg-white rounded-lg border border-border p-4 hover:shadow-md hover:border-primary/30 transition-all">' +
            '<h3 class="font-medium text-sm text-primary">' + (r.meta && r.meta.title ? r.meta.title : r.url) + '</h3>' +
            '<p class="text-text-secondary text-xs mt-1 line-clamp-2">' + (r.meta && r.meta.description ? r.meta.description : '') + '</p>' +
            '</a>';
        }).join('');
      } catch(e) {
        resultsContainer.innerHTML = '<p class="text-text-secondary text-center py-8 text-sm">搜索出错，请稍后重试</p>';
      }
    }

    // Debounced search
    var debounceTimer;
    input.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function() {
        performSearch(input.value);
      }, 300);
    });

    // Track search terms to localStorage
    function trackSearch(term) {
      if (!term || term.trim().length < 2) return;
      try {
        var key = 'ai_site_search_log';
        var log = JSON.parse(localStorage.getItem(key) || '[]');
        log.push({ q: term.trim(), t: Date.now() });
        // Keep last 500 entries
        if (log.length > 500) log = log.slice(-500);
        localStorage.setItem(key, JSON.stringify(log));
      } catch(e) {}
    }

    var trackTimer;
    input.addEventListener('input', function() {
      clearTimeout(trackTimer);
      trackTimer = setTimeout(function() {
        trackSearch(input.value);
      }, 2000); // Track after 2s of no typing
    });

    // Track on Enter key
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        trackSearch(input.value);
      }
    });

    // Perform initial search if query exists
    if (initialQuery) {
      performSearch(initialQuery);
    }
  })();
</script>
