---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoleMap from '../components/RoleMap.astro';
import ScenarioCard from '../components/ScenarioCard.astro';
import ToolCard from '../components/ToolCard.astro';
import FreeAlternativeItem from '../components/FreeAlternativeItem.astro';
import { getAllTools, getAllScenarios, getAllRoles, getFreeAlternatives } from '../utils/data';
import { generateWebsiteJsonLd } from '../utils/seo';

const BASE = import.meta.env.BASE_URL || '/';

const tools = getAllTools();
const scenarios = getAllScenarios();
const roles = getAllRoles();
const freeAlts = getFreeAlternatives();

// Latest tools (sorted by updatedAt)
const latestTools = [...tools].sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()).slice(0, 4);

// Hot scenarios (first 3)
const hotScenarios = scenarios.slice(0, 3);

// Free alternatives preview (first 4)
const freeAltsPreview = freeAlts.slice(0, 4);

const jsonLd = generateWebsiteJsonLd();
---

<BaseLayout
  meta={{
    title: '普通人AI实战笔记',
    description: '帮你找到真正好用的AI工具。按场景找工具、真实评测、免费替代。让普通人也能用好AI。',
  }}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="text-center py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold leading-tight">
        帮你找到
        <span class="text-primary">真正好用</span>
        的AI工具
      </h1>
      <p class="text-text-secondary text-base md:text-lg mt-4 leading-relaxed">
        按场景找工具 · 真实评测 · 免费替代
      </p>
      <div class="flex items-center justify-center gap-4 mt-8">
        <a
          href={`${BASE}scenarios`}
          class="px-6 py-2.5 bg-primary bg-gradient-to-r from-primary to-primary-light text-white font-medium rounded-lg hover:opacity-90 transition-opacity text-sm"
        >
          开始探索
        </a>
        <a
          href={`${BASE}free-alternatives`}
          class="px-6 py-2.5 bg-white border-2 border-primary text-primary font-medium rounded-lg hover:bg-primary/5 transition-colors text-sm shadow-sm"
        >
          免费替代专题 →
        </a>
      </div>
    </div>
  </section>

  <!-- Role Map -->
  <section class="mb-16">
    <RoleMap roles={roles} scenarios={scenarios} />
  </section>

  <!-- Hot Scenarios -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold">🔥 热门场景推荐</h2>
      <a href={`${BASE}scenarios`} class="text-sm text-primary hover:underline font-medium">查看全部 →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {hotScenarios.map((scenario) => (
        <ScenarioCard scenario={scenario} />
      ))}
    </div>
  </section>

  <!-- Free Alternatives Preview -->
  {freeAltsPreview.length > 0 && (
    <section class="mb-16">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">🆓 免费替代专区</h2>
        <a href={`${BASE}free-alternatives`} class="text-sm text-primary hover:underline font-medium">查看全部 →</a>
      </div>
      <div class="bg-bg-white rounded-[var(--radius-card-lg)] border border-border p-6 space-y-3">
        {freeAltsPreview.map((alt) => (
          <FreeAlternativeItem alternative={{ paidToolId: alt.paidTool.id, freeToolId: alt.freeTool.id, note: alt.note }} />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Reviews -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold">📊 最新评测</h2>
      <a href={`${BASE}tools`} class="text-sm text-primary hover:underline font-medium">查看全部 →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {latestTools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

</BaseLayout>
