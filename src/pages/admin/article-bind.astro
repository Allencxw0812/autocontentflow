---
// 公众号文章 ↔ 工具绑定管理
import { getAllTools, getAllScenarios } from '../../utils/data';

const BASE = import.meta.env.BASE_URL || '/';
const tools = getAllTools();

// 绑定状态统计
const linked = tools.filter(t => t.articles?.some((a: any) => a.url && a.url !== '#'));
const empty = tools.filter(t => !t.articles?.some((a: any) => a.url && a.url !== '#'));
const now = new Date().toISOString().split('T')[0];
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>文章绑定管理 | 运营后台</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f7; color: #1a1a1a; }
    .main { max-width: 1200px; margin: 0 auto; padding: 24px 32px; }
    h1 { font-size: 22px; margin-bottom: 4px; }
    .subtitle { font-size: 13px; color: #888; margin-bottom: 24px; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .card { background: #fff; border-radius: 12px; padding: 20px; border: 1px solid #e8e8ec; }
    .card h3 { font-size: 14px; color: #666; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; padding: 10px 12px; color: #888; font-weight: 600; border-bottom: 2px solid #f0f0f0; font-size: 12px; }
    td { padding: 10px 12px; border-bottom: 1px solid #f5f5f5; vertical-align: middle; }
    tr:hover td { background: #fafaff; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .badge-green { background: #ecfdf5; color: #059669; }
    .badge-red { background: #fef2f2; color: #dc2626; }
    .badge-gray { background: #f3f4f6; color: #6b7280; }
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 8px; font-size: 12px; text-decoration: none; font-weight: 500; border: 1px solid #ddd; background: #fff; color: #333; cursor: pointer; }
    .btn-primary { background: #6366F1; color: #fff; border-color: #6366F1; }
    .btn:hover { opacity: 0.85; }
    .tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
    .tag { padding: 4px 12px; border-radius: 16px; font-size: 12px; background: #f0f0ff; color: #6366F1; border: 1px solid #e0e0ff; cursor: pointer; }
    .tag.active { background: #6366F1; color: #fff; border-color: #6366F1; }
    input[type="text"] { width: 100%; padding: 8px 12px; border: 1px solid #e0e0e0; border-radius: 8px; font-size: 13px; }
    input[type="text"]:focus { outline: none; border-color: #6366F1; box-shadow: 0 0 0 2px rgba(99,102,241,0.1); }
    .actions { display: flex; gap: 8px; margin: 16px 0; }
    @media (max-width: 768px) { .grid-2 { grid-template-columns: 1fr; } .main { padding: 16px; } }
  </style>
</head>
<body>
  <div class="main">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
      <div>
        <h1>📝 文章绑定管理</h1>
        <p class="subtitle">绑定公众号文章到网站工具 · 数据刷新: {now}</p>
      </div>
      <div style="display:flex;gap:8px;">
        <a href={`${BASE}admin/`} class="btn">运营总览</a>
        <a href={`${BASE}admin/search-stats/`} class="btn">搜索统计</a>
        <a href={`${BASE}admin/article-bind/`} class="btn btn-primary">文章管理</a>
      </div>
    </div>

    <!-- 统计卡片 -->
    <div class="tag-row" style="margin-bottom:24px;">
      <span class="tag active">全部 ({tools.length})</span>
      <span class="tag" style="background:#ecfdf5;color:#059669;border-color:#a7f3d0;">已绑定 ({linked.length})</span>
      <span class="tag" style="background:#fef2f2;color:#dc2626;border-color:#fecaca;">待绑定 ({empty.length})</span>
    </div>

    <div class="grid-2">
      <!-- 待绑定工具 -->
      <div class="card">
        <h3>❌ 待绑定工具 ({empty.length})</h3>
        <table>
          <thead><tr><th>工具</th><th>已有文章数</th><th>操作</th></tr></thead>
          <tbody>
            {empty.map(t => (
              <tr>
                <td>
                  <span style="font-size:16px;">{t.logo}</span>
                  <a href={`${BASE}tools/${t.slug}`} target="_blank" style="color:#6366F1;text-decoration:none;font-weight:500;">{t.name}</a>
                </td>
                <td><span class="badge badge-gray">{t.articles?.filter((a: any) => a.url !== '#').length || 0}篇</span></td>
                <td>
                  <button class="btn" onclick="openBind('{t.id}','{t.name}')" style="font-size:11px;">+ 绑定</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- 已绑定工具 -->
      <div class="card">
        <h3>✅ 已绑定工具 ({linked.length})</h3>
        <table>
          <thead><tr><th>工具</th><th>关联文章</th><th>操作</th></tr></thead>
          <tbody>
            {linked.map(t => (
              <tr>
                <td>
                  <span style="font-size:16px;">{t.logo}</span>
                  <a href={`${BASE}tools/${t.slug}`} target="_blank" style="color:#6366F1;text-decoration:none;font-weight:500;">{t.name}</a>
                </td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                  {t.articles?.filter((a: any) => a.url && a.url !== '#').map((a: any) => (
                    <div style="font-size:12px;">
                      <a href={a.url} target="_blank" style="color:#6366F1;">{a.title}</a>
                    </div>
                  ))}
                </td>
                <td>
                  <button class="btn" onclick="openBind('{t.id}','{t.name}')" style="font-size:11px;">编辑</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 命令行说明 -->
    <div class="card" style="margin-top:24px;">
      <h3>🛠️ 命令行工具</h3>
      <div style="background:#1a1a2e;color:#e2e8f0;padding:16px;border-radius:8px;font-family:monospace;font-size:12px;line-height:1.8;">
        <div># 扫描参考文章，智能匹配工具</div>
        <div style="color:#38bdf8;">node scripts/wechat.mjs scan</div>
        <div>&nbsp;</div>
        <div># 绑定文章到工具</div>
        <div style="color:#38bdf8;">node scripts/wechat.mjs bind "AI十分钟出行攻略.md" kimi</div>
        <div>&nbsp;</div>
        <div># 查看绑定状态</div>
        <div style="color:#38bdf8;">node scripts/wechat.mjs list</div>
        <div>&nbsp;</div>
        <div># 一键构建+提交+推送部署</div>
        <div style="color:#4ade80;">node scripts/wechat.mjs deploy</div>
      </div>
    </div>

    <!-- 弹窗：绑定表单 -->
    <div id="bind-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:100;align-items:center;justify-content:center;">
      <div style="background:#fff;border-radius:16px;padding:24px;width:480px;max-width:90vw;">
        <h3 style="margin-bottom:16px;">绑定公众号文章</h3>
        <div style="margin-bottom:12px;">
          <label style="font-size:13px;color:#666;display:block;margin-bottom:4px;">工具</label>
          <input type="text" id="bind-tool-name" readonly style="background:#f5f5f7;" />
        </div>
        <div style="margin-bottom:12px;">
          <label style="font-size:13px;color:#666;display:block;margin-bottom:4px;">文章标题</label>
          <input type="text" id="bind-title" placeholder="如：AI十分钟出旅行攻略" />
        </div>
        <div style="margin-bottom:12px;">
          <label style="font-size:13px;color:#666;display:block;margin-bottom:4px;">公众号文章链接</label>
          <input type="text" id="bind-url" placeholder="https://mp.weixin.qq.com/s/xxxx" />
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
          <button class="btn" onclick="closeBind()">取消</button>
          <button class="btn btn-primary" onclick="saveBind()">保存</button>
        </div>
        <p style="font-size:11px;color:#999;margin-top:12px;">
          💡 提示：绑定信息保存在本地，需要通过命令行工具执行 node scripts/wechat.mjs bind 才能真正写入 tools.json 并部署。
        </p>
      </div>
    </div>
  </div>

  <script>
    let currentToolId = '';
    const BASE = '{`${BASE}`}';

    function openBind(toolId, toolName) {
      currentToolId = toolId;
      document.getElementById('bind-tool-name').value = toolName;
      document.getElementById('bind-modal').style.display = 'flex';
    }

    function closeBind() {
      document.getElementById('bind-modal').style.display = 'none';
    }

    function saveBind() {
      const title = document.getElementById('bind-title').value.trim();
      const url = document.getElementById('bind-url').value.trim();
      if (!title) { alert('请输入文章标题'); return; }

      // 生成命令
      const cmd = `node scripts/wechat.mjs bind "${title}" ${currentToolId}`;
      const envCmd = url ? `WECHAT_URL="${url}" ${cmd}` : cmd;

      // 复制到剪贴板
      if (navigator.clipboard) {
        navigator.clipboard.writeText(envCmd).then(() => {
          alert('✅ 命令已复制到剪贴板！在终端中粘贴执行：\n\n' + envCmd);
        });
      } else {
        alert('请在终端执行：\n\n' + envCmd);
      }
      closeBind();
    }

    // 点击遮罩关闭
    document.getElementById('bind-modal').addEventListener('click', function(e) {
      if (e.target === this) closeBind();
    });
  </script>
</body>
</html>
