---
import type { Role, Scenario } from '../types/index';

interface Props {
  roles: Role[];
  scenarios: Scenario[];
}

const { roles, scenarios } = Astro.props;
---

<section>
  <div class="text-center mb-8">
    <h2 class="text-2xl font-bold">🗺️ 场景化工具地图</h2>
    <p class="text-text-secondary text-sm mt-2">按你的角色和场景，找到最合适的AI工具</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {roles.map((role) => {
      const roleScenarios = scenarios.filter((s) => s.role === role.id);
      return (
        <a
          href={`/scenarios#${role.id}`}
          class="block bg-bg-white rounded-[var(--radius-card-lg)] border border-border hover:shadow-md hover:border-primary/30 transition-all p-6 group"
        >
          <div class="text-3xl mb-3">{role.icon}</div>
          <h3 class="font-semibold group-hover:text-primary transition-colors">{role.name}</h3>
          <p class="text-text-secondary text-xs mt-1">{role.description}</p>
          <ul class="mt-3 space-y-1">
            {roleScenarios.map((s) => (
              <li class="text-xs text-text-secondary flex items-center gap-1">
                <span class="text-primary/50">→</span> {s.name}
              </li>
            ))}
          </ul>
          <div class="mt-3 text-xs text-primary font-medium">
            {roleScenarios.length}个场景 →
          </div>
        </a>
      );
    })}
  </div>
</section>
