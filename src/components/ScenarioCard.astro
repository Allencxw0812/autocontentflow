---
import type { Scenario } from '../types/index';
const BASE = import.meta.env.BASE_URL || '/';

interface Props {
  scenario: Scenario;
}

const { scenario } = Astro.props;
---

<a href={`${BASE}scenarios/${scenario.slug}`} class="block bg-bg-white rounded-[var(--radius-card)] border border-border hover:shadow-md hover:border-primary/30 transition-all p-5 group">
  <div class="flex items-start gap-3">
    <span class="text-2xl">{scenario.icon}</span>
    <div class="flex-1">
      <h3 class="font-semibold text-sm group-hover:text-primary transition-colors">{scenario.name}</h3>
      <p class="text-text-secondary text-xs mt-1 line-clamp-2">{scenario.tagline}</p>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-xs text-text-secondary">
          {scenario.tools.length}个工具推荐
        </span>
        <span class="text-text-secondary/40">·</span>
        <span class="text-xs text-text-secondary">
          {scenario.workflow.length}步工作流
        </span>
      </div>
    </div>
  </div>
</a>
