---
import type { Tool } from '../types/index';

interface Props {
  tool: Tool;
}

import { formatPricing, getOverallRating, formatRating } from '../utils/formatters';
import { getToolFavicon, getToolIcon } from '../utils/data';
const { tool } = Astro.props;
const BASE = import.meta.env.BASE_URL || '/';

const pricingInfo = formatPricing(tool.pricing);
const overallRating = getOverallRating(tool.rating);
---

<a href={`${BASE}tools/${tool.slug}`} class="block bg-bg-white rounded-[var(--radius-card)] border border-border hover:shadow-md hover:border-primary/30 transition-all p-5 group">
  <div class="flex items-start gap-4">
    <!-- Logo -->
    <div class="w-12 h-12 rounded-lg bg-white border border-border flex items-center justify-center shrink-0 overflow-hidden">
      <img
        src={getToolIcon(tool.id)}
        alt={tool.name}
        class="w-8 h-8 object-contain"
        onerror={`this.onerror=null;this.src='${getToolFavicon(tool.url, 64)}'`}
        loading="lazy"
      />
    </div>

    <div class="flex-1 min-w-0">
      <!-- Name + Rating -->
      <div class="flex items-center justify-between gap-2">
        <h3 class="font-semibold text-sm group-hover:text-primary transition-colors truncate">{tool.name}</h3>
        <span class="text-xs text-yellow-500 shrink-0">{formatRating(overallRating)}</span>
      </div>

      <!-- Tagline -->
      <p class="text-text-secondary text-xs mt-1 line-clamp-2">{tool.tagline}</p>

      <!-- Tags -->
      <div class="flex items-center gap-2 mt-3 flex-wrap">
        <span class={`text-xs px-2 py-0.5 rounded-full font-medium border ${pricingInfo.color}`}>
          {pricingInfo.label}
        </span>
        {tool.chineseSupport === 'native' && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200 font-medium">中文原生</span>
        )}
        {tool.needsVPN && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-red-50 text-red-700 border border-red-200 font-medium">需翻墙</span>
        )}
        {tool.freeQuota && !tool.needsVPN && tool.chineseSupport === 'native' && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 font-medium">免费额度</span>
        )}
      </div>
    </div>
  </div>
</a>
