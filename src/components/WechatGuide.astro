---
const BASE = import.meta.env.BASE_URL;
---

<div id="wechat-guide" class="fixed bottom-0 left-0 right-0 z-40 bg-bg-white border-t border-border shadow-lg transform translate-y-0 transition-transform duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <img src={`${BASE}images/qrcode.jpg`} alt="公众号二维码" class="w-16 h-16 rounded-lg border border-border" />
        <div>
          <p class="font-medium text-sm">关注公众号「普通人AI实战笔记」</p>
          <p class="text-text-secondary text-xs">扫码获取更多AI实战经验 · 每周更新</p>
        </div>
      </div>
      <button
        id="wechat-close-btn"
        class="p-1 text-text-secondary hover:text-text-primary transition-colors shrink-0"
        aria-label="关闭"
      >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const guide = document.getElementById('wechat-guide');
  const closeBtn = document.getElementById('wechat-close-btn');
  const STORAGE_KEY = 'wechat-guide-closed';
  const EXPIRY_DAYS = 7;

  function isClosed(): boolean {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (!stored) return false;
    const closedAt = parseInt(stored, 10);
    const now = Date.now();
    const expiryMs = EXPIRY_DAYS * 24 * 60 * 60 * 1000;
    return now - closedAt < expiryMs;
  }

  if (isClosed() && guide) {
    guide.style.display = 'none';
  }

  closeBtn?.addEventListener('click', () => {
    if (guide) {
      guide.style.display = 'none';
    }
    localStorage.setItem(STORAGE_KEY, Date.now().toString());
  });
</script>
